{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "L&P Solutions",
  "version": "0.1.1",
  "identifier": "com.chand.lighter-princess",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
  {
    "label": "main",
    "title": "L&P Solutions",
    "width": 1200,
    "height": 800,
    "minWidth": 900,
    "minHeight": 600,
    "resizable": true,
    "maximizable": true,
    "maximized": true
  }

    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}